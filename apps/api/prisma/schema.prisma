generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CollegeStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum MembershipRole {
  STUDENT
  FACULTY
  CLUB_ADMIN
  DEPARTMENT_ADMIN
  COLLEGE_ADMIN
  PLATFORM_ADMIN
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum ClubRecruitmentStatus {
  OPEN
  PAUSED
  CLOSED
}

enum ClubVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum ClubMembershipRole {
  MEMBER
  LEAD
  SECRETARY
  PRESIDENT
  ADMIN
}

enum ClubMembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum NotificationType {
  SYSTEM
  COLLEGE
  CLUB
  EVENT
  REGISTRATION
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  phone           String?             @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          UserStatus          @default(ACTIVE)
  lastLoginAt     DateTime?
  memberships     CollegeMembership[]
  refreshSessions RefreshSession[]
  organizedEvents Event[]             @relation("EventOrganizer")
  registrations   EventRegistration[]
  clubMemberships ClubMembership[]
  notifications   Notification[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@map("users")
}

model College {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  officialEmailDomain String?
  website             String?
  logoUrl             String?
  coverUrl            String?
  description         String?
  address             String?
  city                String?
  state               String?
  country             String              @default("India")
  status              CollegeStatus       @default(PENDING)
  memberships         CollegeMembership[]
  departments         Department[]
  clubs               Club[]
  events              Event[]
  registrations       EventRegistration[]
  notifications       Notification[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@map("colleges")
}

model CollegeMembership {
  id        String           @id @default(cuid())
  userId    String
  collegeId String
  role      MembershipRole
  status    MembershipStatus @default(PENDING)
  studentId String?
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId, role])
  @@index([collegeId, status])
  @@index([userId, status])
  @@map("college_memberships")
}

model Department {
  id          String  @id @default(cuid())
  collegeId   String
  name        String
  code        String
  description String?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  clubs   Club[]
  events  Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, code])
  @@index([collegeId, name])
  @@map("departments")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Club {
  id                 String                 @id @default(cuid())
  collegeId          String
  departmentId       String?
  name               String
  slug               String
  description        String?
  category           String                 @default("General")
  logoUrl            String?
  coverUrl           String?
  recruitmentStatus  ClubRecruitmentStatus  @default(CLOSED)
  verificationStatus ClubVerificationStatus @default(PENDING)
  isActive           Boolean                @default(true)

  college      College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  memberships  ClubMembership[]
  events       Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, slug])
  @@index([collegeId, isActive])
  @@index([collegeId, category])
  @@index([departmentId])
  @@map("clubs")
}

model ClubMembership {
  id        String               @id @default(cuid())
  clubId    String
  userId    String
  role      ClubMembershipRole   @default(MEMBER)
  status    ClubMembershipStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, status])
  @@index([clubId, status])
  @@map("club_memberships")
}

model Event {
  id                   String      @id @default(cuid())
  collegeId            String
  clubId               String?
  departmentId         String?
  organizerId          String
  slug                 String
  title                String
  description          String
  eventType            String      @default("GENERAL")
  venue                String
  onlineMeetingUrl     String?
  imageUrl             String?
  posterUrl            String?
  startsAt             DateTime
  endsAt               DateTime
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  capacity             Int?
  feeAmount            Decimal?    @db.Decimal(10, 2)
  currency             String      @default("INR")
  status               EventStatus @default(DRAFT)

  college       College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  club          Club?               @relation(fields: [clubId], references: [id], onDelete: SetNull)
  department    Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  organizer     User                @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([collegeId, slug])
  @@index([collegeId, status, startsAt])
  @@index([clubId, startsAt])
  @@index([departmentId, startsAt])
  @@map("events")
}

model EventRegistration {
  id               String             @id @default(cuid())
  collegeId        String
  eventId          String
  userId           String
  status           RegistrationStatus @default(REGISTERED)
  registrationCode String             @unique
  qrToken          String             @unique @default(cuid())
  registeredAt     DateTime           @default(now())
  cancelledAt      DateTime?
  checkedInAt      DateTime?
  checkedInBy      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([collegeId, status])
  @@index([userId, status])
  @@index([eventId, status])
  @@map("event_registrations")
}

model Notification {
  id        String           @id @default(cuid())
  collegeId String
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([collegeId, userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
